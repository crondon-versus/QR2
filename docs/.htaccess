# El historico contiene las URL de todas las campanas: no debe poder leerse
# desde la web. Se descarga por FTP.
<Files "historico.csv">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Los acentos de la pagina, por si el servidor no manda la cabecera.
<IfModule mod_mime.c>
    AddDefaultCharset UTF-8
</IfModule>
